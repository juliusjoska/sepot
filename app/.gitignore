# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Runtime artefakty lokálních běhů (šifrované bloby příloh)
/attachments/

# Generované Flutter soubory s lokálními build cestami — nikdy necommitovat
**/Flutter/Generated.xcconfig
**/Flutter/flutter_export_environment.sh
**/flutter/ephemeral/

# Firebase FCM (opt-in) — reálný config dodává provozovatel, do repa nepatří
android/app/google-services.json
