# Zkopíruj jako `.env` vedle docker-compose.yml a vyplň. NIKDY necommitovat.

# --- Povinné ---
# Heslo k PostgreSQL (zvol silné, náhodné).
POSTGRES_PASSWORD=

# --- Volitelné: nativní APNs push (iOS). Nech prázdné, pokud nepoužíváš —
# relay pak jede na UnifiedPush. Klíč .p8 se mountuje v docker-compose.yml.
SEPOT_APNS_KEY_ID=
SEPOT_APNS_TEAM_ID=
SEPOT_APNS_TOPIC=
